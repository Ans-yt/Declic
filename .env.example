# Local: copy to .env. DeployXA: set these in the server's environment/secret settings.
# Never prefix secrets with VITE_: Vite variables are visible to every visitor.
# Leave NODE_ENV unset locally so Vite can produce an optimised production build.
# Set NODE_ENV=production in DeployXA (the Dockerfile already does).
HOST=127.0.0.1
PORT=4173
DECLIC_DB=data/declic.sqlite
# Production: use a FILE inside the host's persistent mount, not the mount directory.
# If DECLIC_DB is unset, a host-injected DATABASE_URL (SQLite/file URL) is used.
# PostgreSQL/MySQL URLs are not supported. Do not set both unless overriding intentionally.
# Production: NODE_ENV=production, HOST=0.0.0.0, exact HTTPS URL without a path.
APP_ORIGIN=
# Set to the actual number of trusted reverse-proxy hops; do not blindly enable all proxies.
TRUST_PROXY_HOPS=0
DECLIC_STAFF_USERNAME=
# Generate with npm run staff:password. No default password is shipped.
DECLIC_STAFF_PASSWORD_HASH=
DECLIC_INSTITUTION_NAME=Déclic
# Optional: an institution must register this client and provision permitted identities.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Random secret of at least 32 characters; only for institution-to-server provisioning.
DECLIC_INTEGRATION_TOKEN=
